# DB (replace with your own Postgres connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth (min 32 chars — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
SESSION_SECRET="replace-with-a-long-random-secret-min-32-chars"

# Seeded admin account (used by prisma/seed.ts, change after first login)
ADMIN_EMAIL="admin@konnecttech.com"
ADMIN_PASSWORD="Admin123!"

# UploadThing (image uploads — get a token at https://uploadthing.com/dashboard)
UPLOADTHING_TOKEN="paste-your-uploadthing-token-here"
